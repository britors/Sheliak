{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": [
      "@girs/gnome-shell/ambient",
      "@girs/gnome-shell/extensions/global"
    ]
  },
  "include": ["src/**/*.ts"]
}
